# IA Pod Errepar – environment variables example
# Copy to .env.local and adjust for your environment.

# Model Gateway provider: "mock" (default, no credentials needed) | "openai"
GATEWAY_PROVIDER=mock

# OpenAI-compatible provider – only needed when GATEWAY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Free-tier demos:
# - OpenRouter: set OPENAI_BASE_URL=https://openrouter.ai/api/v1 and a free model
#   like OPENAI_MODEL=google/gemma-3-4b-it:free
# - Groq: set OPENAI_BASE_URL=https://api.groq.com/openai/v1 and a supported model
