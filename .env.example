# IA Pod Errepar – environment variables example
# Copy to .env.local and adjust for your environment.

# Model Gateway provider: "mock" (default, no credentials needed) | "openai" | "anthropic"
GATEWAY_PROVIDER=mock

# OpenAI – only needed when GATEWAY_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic – only needed when GATEWAY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
